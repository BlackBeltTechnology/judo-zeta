<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>hu.blackbelt.judo.zeta</groupId>
		<artifactId>hu.blackbelt.judo.zeta</artifactId>
        <version>${revision}</version>
	</parent>
	<artifactId>hu.blackbelt.judo.zeta.transformation-core</artifactId>
	<packaging>bundle</packaging>

	<name>Judo :: Zeta :: Transformation Core</name>
	<description>Annotation-based transformation framework for EMF metamodels (ETL replacement)</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<obrRepository>NONE</obrRepository>
					<instructions>
						<Import-Package>
                            ${osgi-default-import},
							*
						</Import-Package>
						<Export-Package>
                            hu.blackbelt.judo.zeta.transformation.core;version=${project.version},
                            hu.blackbelt.judo.zeta.transformation.core.deferred;version=${project.version},
                        </Export-Package>
					</instructions>
				</configuration>
			</plugin>
        </plugins>
	</build>

    <dependencies>
        <!-- Shared modules -->
        <dependency>
            <groupId>hu.blackbelt.judo.zeta</groupId>
            <artifactId>hu.blackbelt.judo.zeta.common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.judo.zeta</groupId>
            <artifactId>hu.blackbelt.judo.zeta.annotations</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore</artifactId>
            <version>2.38.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
            <version>2.38.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.common</artifactId>
            <version>2.31.0</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
	</dependencies>

	<!-- ============================================================ -->
	<!-- Performance Testing Profiles                                   -->
	<!-- ============================================================ -->
	<profiles>
		<profile>
			<id>performance</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<groups>performance</groups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
